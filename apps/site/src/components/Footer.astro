---
// Footer compartilhado do Site Institucional.
const centralUrl = import.meta.env.PUBLIC_CENTRAL_URL ?? '';
const consultaUrl = centralUrl ? `${centralUrl}/consulta` : '/consulta';
const ano = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <div class="brand" style="margin-bottom:var(--sp-4)">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5c-1.6-1-4-1.6-6.5-1.6C4 3.4 3 3.6 3 4.5v13c0 .6.5 1 1.1.9C6.3 18 9.5 18.4 12 20c2.5-1.6 5.7-2 7.9-1.6.6.1 1.1-.3 1.1-.9v-13c0-.9-1-1.1-2.5-1.1C16 3.4 13.6 4 12 5Z"/><path d="M12 5v15"/></svg>
          </span>
          <span><span class="brand__name" style="color:#fff">Instituto <span style="color:var(--gold-400)">Teológico Servo</span></span></span>
        </div>
        <p style="font-size:var(--text-sm);max-width:34ch">Formando servos fiéis para o Reino de Deus, com ensino bíblico sólido, acessível e comprometido com a edificação da Igreja.</p>
      </div>
      <div>
        <h4>Parcerias</h4>
        <ul>
          <li class="footer__partner"><span></span>Assembleia de Deus Ministério Família</li>
          <li class="footer__partner"><span></span>CNMCB — Convenção Nacional dos Ministros de Cristo do Brasil</li>
        </ul>
      </div>
      <div>
        <h4>Links rápidos</h4>
        <ul>
          <li><a href="/">Início</a></li>
          <li><a href="/quem-somos">Quem Somos</a></li>
          <li><a href="/cursos">Cursos</a></li>
          <li><a href="/nucleos">Núcleos</a></li>
          <li><a href="/metodologia">Metodologia</a></li>
          <li><a href="/inscricao">Inscrição</a></li>
          <li><a href={consultaUrl}>Consultar Inscrição</a></li>
        </ul>
      </div>
      <div>
        <h4>Contato</h4>
        <ul>
          <li>WhatsApp: (11) 97229-4009</li>
          <li>institutoteologicoits@gmail.com</li>
          <li>São Paulo — SP, Brasil</li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {ano} Instituto Teológico Servo. Todos os direitos reservados.</span>
      <span style="font-style:italic;font-family:var(--font-serif)">Soli Deo Gloria</span>
    </div>
  </div>
</footer>
