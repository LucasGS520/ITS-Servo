---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Solicitar inscrição — Instituto Teológico Servo">
  <PageHero
    eyebrow="Comece sua jornada"
    title="Solicite sua inscrição"
    subtitle="Envie seus dados para iniciar sua inscrição no Instituto Teológico Servo."
  />

  <section class="section">
    <div class="wrap" style="max-width:44rem">
      <form id="form-inscricao" class="card" style="display:flex;flex-direction:column;gap:var(--sp-6)">
        <div>
          <h2 style="font-size:var(--text-xl);margin-bottom:var(--sp-4)">Dados Pessoais</h2>
          <div style="display:flex;flex-direction:column;gap:var(--sp-5)">
            <div class="field">
              <label for="nome_completo">Nome completo *</label>
              <input class="input" id="nome_completo" name="nome_completo" required minlength="3" placeholder="Seu nome completo" />
            </div>
            <div class="grid cols-2" style="gap:var(--sp-5)">
              <div class="field">
                <label for="cpf">CPF *</label>
                <input class="input" id="cpf" name="cpf" required inputmode="numeric" placeholder="000.000.000-00" />
              </div>
              <div class="field">
                <label for="telefone">Telefone / WhatsApp *</label>
                <input class="input" id="telefone" name="telefone" required inputmode="numeric" placeholder="(00) 00000-0000" />
              </div>
            </div>
            <div class="field">
              <label for="email">E-mail *</label>
              <input class="input" id="email" name="email" type="email" required placeholder="seu@email.com" />
              <span class="field__hint">Usaremos este endereço apenas como dado de contato da matrícula.</span>
            </div>
            <div class="grid cols-2" style="gap:var(--sp-5)">
              <div class="field">
                <label for="data_nascimento">Data de nascimento *</label>
                <input class="input" id="data_nascimento" name="data_nascimento" type="date" required />
              </div>
              <div class="field">
                <label for="escolaridade">Grau de escolaridade *</label>
                <select class="input" id="escolaridade" name="escolaridade" required>
                  <option value="" disabled selected>Selecione…</option>
                  <option value="fundamental">Ensino Fundamental</option>
                  <option value="medio">Ensino Médio</option>
                  <option value="superior">Ensino Superior</option>
                  <option value="pos_graduacao">Pós-graduação</option>
                  <option value="outro">Outro</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <div style="border-top:1px solid var(--line);padding-top:var(--sp-6)">
          <h2 style="font-size:var(--text-xl);margin-bottom:var(--sp-4)">Atividade</h2>
          <div class="field">
            <label for="destino_publico">Curso ou simpósio *</label>
            <select class="input" id="destino_publico" name="destino_publico" required>
              <option value="" disabled selected>Carregando atividades...</option>
            </select>
            <span class="field__hint">Mostramos apenas atividades abertas para inscrição.</span>
          </div>
        </div>

        <div style="border-top:1px solid var(--line);padding-top:var(--sp-6)">
          <h2 style="font-size:var(--text-xl);margin-bottom:var(--sp-4)">Dados Acadêmicos</h2>
          <div class="field">
            <label>Modalidade *</label>
            <label style="font-weight:400;display:flex;align-items:center;gap:.5rem;cursor:pointer">
              <input type="radio" name="modalidade" value="presencial" required /> Presencial
            </label>
            <label style="font-weight:400;display:flex;align-items:center;gap:.5rem;cursor:pointer">
              <input type="radio" name="modalidade" value="correspondencia" /> Por Correspondência
            </label>
          </div>
          <div class="field" id="nucleo-wrap" style="margin-top:var(--sp-5);display:none">
            <label for="nucleo">Núcleo *</label>
            <select class="input" id="nucleo" name="nucleo">
              <option value="" disabled selected>Selecione o núcleo…</option>
            </select>
          </div>
        </div>

        <button class="btn btn--gold btn--lg btn--block" type="submit">Enviar solicitação</button>
        <p id="form-msg" style="text-align:center;font-size:var(--text-sm);color:var(--muted)"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  import { createBrowserClient, listarDestinosPublicos, listarNucleosPublicos, solicitarInscricao } from '@its-servo/supabase';

  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  // Obrigatória no build: a solicitação sempre termina no autosserviço da Central.
  const centralUrl = import.meta.env.PUBLIC_CENTRAL_URL;

  const form = document.getElementById('form-inscricao') as HTMLFormElement;
  const msg = document.getElementById('form-msg') as HTMLParagraphElement;
  const nucleoWrap = document.getElementById('nucleo-wrap') as HTMLDivElement;
  const nucleoSel = document.getElementById('nucleo') as HTMLSelectElement;
  const destinoSel = document.getElementById('destino_publico') as HTMLSelectElement;

  if (url && key) {
    const client = createBrowserClient(url, key);
    listarNucleosPublicos(client).then((nucleos) => {
      nucleos.forEach((nucleo) => {
        const option = document.createElement('option');
        option.value = nucleo.slug;
        option.textContent = `${nucleo.nome} (${nucleo.cidade}/${nucleo.uf})`;
        nucleoSel.appendChild(option);
      });
    }).catch(() => { msg.textContent = 'Não foi possível carregar os núcleos. Tente novamente.'; });
    listarDestinosPublicos(client).then((destinos) => {
      destinoSel.innerHTML = '';
      const inicial = document.createElement('option');
      inicial.value = '';
      inicial.textContent = destinos.length ? 'Selecione a atividade...' : 'Nenhuma atividade aberta no momento';
      inicial.disabled = true;
      inicial.selected = true;
      destinoSel.appendChild(inicial);
      destinos.forEach((destino) => {
        const option = document.createElement('option');
        option.value = destino.tipo === 'curso' ? `curso:${destino.codigo}` : `simposio:${destino.id}`;
        const moeda = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        option.textContent = destino.tipo === 'curso'
          ? `${destino.nome} — matrícula ${moeda(destino.taxa_matricula)} · mensalidade ${moeda(destino.mensalidade_referencia)}`
          : destino.valor == null ? destino.nome : `${destino.nome} — ${moeda(destino.valor)}`;
        destinoSel.appendChild(option);
      });
    }).catch(() => { destinoSel.innerHTML = '<option value="">Não foi possível carregar as atividades</option>'; msg.textContent = 'Não foi possível carregar as atividades. Tente novamente.'; });
  }

  // Mostra/oculta o núcleo conforme a modalidade
  form.querySelectorAll('input[name="modalidade"]').forEach((el) =>
    el.addEventListener('change', () => {
      const presencial = (form.elements.namedItem('modalidade') as RadioNodeList).value === 'presencial';
      nucleoWrap.style.display = presencial ? 'flex' : 'none';
      nucleoSel.required = presencial;
      if (!presencial) nucleoSel.value = '';
    }),
  );

  // Máscaras de CPF/telefone (o servidor revalida — isto é só UX)
  const cpfInput = document.getElementById('cpf') as HTMLInputElement;
  const telInput = document.getElementById('telefone') as HTMLInputElement;
  cpfInput.addEventListener('input', () => {
    const d = cpfInput.value.replace(/\D/g, '').slice(0, 11);
    cpfInput.value = d
      .replace(/^(\d{3})(\d)/, '$1.$2')
      .replace(/^(\d{3})\.(\d{3})(\d)/, '$1.$2.$3')
      .replace(/\.(\d{3})(\d{1,2})$/, '.$1-$2');
  });
  telInput.addEventListener('input', () => {
    const d = telInput.value.replace(/\D/g, '').slice(0, 11);
    telInput.value = d.length <= 10
      ? d.replace(/^(\d{2})(\d)/, '($1) $2').replace(/(\d{4})(\d{1,4})$/, '$1-$2')
      : d.replace(/^(\d{2})(\d)/, '($1) $2').replace(/(\d{5})(\d{1,4})$/, '$1-$2');
  });

  // Mesmo algoritmo de dígitos verificadores do servidor (_shared/cpf.ts)
  function cpfValido(cpf: string): boolean {
    const d = cpf.replace(/\D/g, '');
    if (d.length !== 11 || /^(\d)\1{10}$/.test(d)) return false;
    let s = 0;
    for (let i = 0; i < 9; i++) s += parseInt(d[i]) * (10 - i);
    let r = (s * 10) % 11;
    if (r === 10) r = 0;
    if (r !== parseInt(d[9])) return false;
    s = 0;
    for (let i = 0; i < 10; i++) s += parseInt(d[i]) * (11 - i);
    r = (s * 10) % 11;
    if (r === 10) r = 0;
    return r === parseInt(d[10]);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.textContent = '';
    if (!url || !key) { msg.textContent = 'Configuração do servidor ausente. Tente novamente mais tarde.'; return; }
    if (!cpfValido(cpfInput.value)) {
      msg.textContent = 'CPF inválido — confira os dígitos.';
      cpfInput.focus();
      return;
    }

    const fd = new FormData(form);
    const modalidade = String(fd.get('modalidade') || '');
    const destinoSelecionado = String(fd.get('destino_publico') || '');
    if (!destinoSelecionado) { msg.textContent = 'Selecione uma atividade disponível.'; return; }
    const [destino, destinoId] = destinoSelecionado.split(':');
    const dto = {
      nome_completo: String(fd.get('nome_completo') || ''),
      cpf: String(fd.get('cpf') || ''),
      telefone: String(fd.get('telefone') || ''),
      email: String(fd.get('email') || ''),
      data_nascimento: String(fd.get('data_nascimento') || ''),
      escolaridade: String(fd.get('escolaridade') || ''),
      modalidade: modalidade as 'presencial' | 'correspondencia',
      nucleo: modalidade === 'presencial' ? String(fd.get('nucleo') || '') : null,
      destino: destino as 'curso' | 'simposio',
      curso_codigo: destino === 'curso' ? destinoId as 'teologico' | 'capacitacao_obreiros' : undefined,
      edicao_simposio_id: destino === 'simposio' ? destinoId : null,
    };

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = 'Enviando…';
    try {
      const supabase = createBrowserClient(url, key);
      const { numero_inscricao } = await solicitarInscricao(supabase, dto);
      // Token no fragment (#): não vaza em Referer nem em logs de servidor.
      // A Central apresenta o estado e recebe comprovante opcional.
      window.location.href = `${centralUrl}/consulta#numero=${encodeURIComponent(numero_inscricao)}`;
    } catch (err: any) {
      msg.textContent = 'Não foi possível concluir: ' + (err?.message ?? 'tente novamente.');
    } finally {
      btn.disabled = false;
      btn.textContent = label;
    }
  });
</script>
