---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaInscricao from '../components/CtaInscricao.astro';

const gradeFundamental = [
  'Bibliologia', 'Administração Eclesiástica', 'Doutrina de Deus', 'Família Cristã',
  'Hamartiologia', 'Homilética', 'Antropologia', 'Ministério Pastoral',
  'O Pentateuco', 'Missiologia', 'Paracletologia', 'Liderança Cristã',
];
const gradeBasico = [
  ...gradeFundamental,
  'Soteriologia', 'Tipologia', 'Evangelismo', 'Livros Históricos 1', 'Os Evangelhos',
  'Evangelismo, Integração e Discipulado', 'Cristologia', 'Eclesiologia',
  'Atos dos Apóstolos', 'Ética Cristã', 'Epístolas Paulinas', 'Mordomia Cristã',
];
const gradeMedio = [
  ...gradeBasico,
  'Hermenêutica', 'Livros Poéticos', 'Livros Proféticos 1', 'Livros Proféticos 2',
  'Batalha Espiritual', 'Livros Históricos 2', 'Epístolas Gerais', 'Geografia Bíblica',
  'Escatologia', 'Angelologia', 'Doutrinas Bíblicas', 'Soteriologia',
];
const niveis = [
  { titulo: 'Fundamental', desc: 'Base sólida na fé cristã com 12 matérias essenciais para o início da formação teológica.', materias: gradeFundamental },
  { titulo: 'Básico', desc: 'Aprofundamento teológico com 24 matérias, expandindo os fundamentos para uma compreensão mais ampla.', materias: gradeBasico },
  { titulo: 'Médio', desc: 'Formação completa com 36 matérias, abrangendo todo o currículo teológico do ITS.', materias: gradeMedio },
];
---
<Base title="Grade Curricular — Instituto Teológico Servo">
  <PageHero
    eyebrow="Acadêmico"
    title="Grade Curricular"
    subtitle="Nossa formação é dividida em três níveis progressivos: Fundamental, Básico e Médio."
  />

  {niveis.map((nivel, i) => (
    <section class={`section ${i % 2 === 1 ? 'section--tint' : ''}`}>
      <div class="wrap">
        <div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-8)">
          <div class="card__icon" style="margin:0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.7 3 6 3s6-2 6-3v-5"/></svg></div>
          <div>
            <h2 style="font-size:var(--text-2xl)">Nível {nivel.titulo} — {nivel.materias.length} matérias</h2>
            <p style="color:var(--muted);font-size:var(--text-sm)">{nivel.desc}</p>
          </div>
        </div>
        <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
          {nivel.materias.map((m) => (
            <div class="card" style="padding:var(--sp-4);display:flex;align-items:center;gap:var(--sp-3)">
              <div class="card__icon" style="width:36px;height:36px;margin:0;border-radius:10px"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5c2.5-.8 5.5-.8 8 .5 2.5-1.3 5.5-1.3 8-.5v13c-2.5-.8-5.5-.8-8 .5-2.5-1.3-5.5-1.3-8-.5z"/><path d="M12 5.5v13"/></svg></div>
              <span style="font-size:var(--text-sm);font-weight:500">{m}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap" style="text-align:center;max-width:60ch">
      <p class="section__desc" style="margin-inline:auto">Todos os núcleos compartilham a mesma grade curricular, variando apenas a sequência de aprendizado.</p>
      <a class="btn btn--outline" href="/nucleos" style="margin-top:var(--sp-6)">Conheça nossos Núcleos</a>
    </div>
  </section>

  <CtaInscricao />
</Base>
