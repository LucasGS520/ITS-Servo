# Variáveis públicas do Site (Astro inlina PUBLIC_* no build do cliente).
# Copie para `.env` e preencha. NÃO commitar o .env real.

# Supabase (para o formulário de inscrição chamar o contrato criar-inscricao)
PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-publica"

# URL da Central Operacional (autosserviço pós-inscrição: pagamento/consulta)
# Ex.: https://painel.itsservo.org
PUBLIC_CENTRAL_URL=""
