# Variáveis da Central Operacional (Produto B).
# Copie para `.env` (produção) ou `.env.local` (dev). NÃO commitar valores reais.

# Supabase — backend compartilhado da plataforma
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/publishable key>"

# URL do Site Institucional (Produto A). A Central não serve conteúdo
# institucional: as rotas antigas (/, /cursos, /nucleos…) redirecionam para lá,
# e o autosserviço oferece "Voltar ao site" apontando para esta URL.
# Ex.: https://itsservo.org  (dev: http://localhost:4321)
VITE_SITE_URL="http://localhost:4321"
