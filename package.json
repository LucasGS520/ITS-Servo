{
  "name": "its-servo",
  "private": true,
  "version": "0.0.0",
  "description": "Plataforma ITS-Servo — Site Institucional (A) + Central Operacional (B)",
  "scripts": {
    "dev:site": "pnpm --filter @its-servo/site dev",
    "dev:central": "pnpm --filter @its-servo/central dev",
    "build:site": "pnpm --filter @its-servo/site build",
    "build:central": "pnpm --filter @its-servo/central build",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=18"
  }
}
